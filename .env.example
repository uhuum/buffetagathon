# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Service Role Key — NUNCA exponha no client-side
# Usada nas API Routes e Scheduled Functions para acesso total ao banco
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ============================================================
# Firebase (client-side — prefixo NEXT_PUBLIC)
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# VAPID Key pública (gerada no Firebase Console → Cloud Messaging → Certificados Web Push)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BNxx...

# ============================================================
# Firebase (server-side — usada nas API Routes para enviar FCM)
# Obtidas em: Firebase Console → Configurações → Contas de serviço → Gerar nova chave privada
# ============================================================
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
# Atenção: copie a chave privada completa, com \n escapados
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBg...\n-----END PRIVATE KEY-----\n"

# ============================================================
# Cron Jobs — Netlify Scheduled Functions
# ============================================================

# Segredo compartilhado entre a Netlify Scheduled Function e a API Route Next.js.
# Gere um valor seguro com: openssl rand -hex 32
CRON_SECRET=seu-segredo-cron-aqui

# URL pública do site — usada pelas Scheduled Functions para chamar as API Routes internas.
# A Netlify injeta esta variável automaticamente em produção com o valor do domínio do site.
# Para desenvolvimento local com `netlify dev`, define manualmente:
# URL=http://localhost:8888
URL=https://seu-site.netlify.app
